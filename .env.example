# ==============================================================================
# AGROCHAIN ERP - CONFIGURACIÓN GLOBAL DE VARIABLES DE ENTORNO (EJEMPLO)
# Copie este archivo como '.env' para personalizar sus credenciales locales.
# ==============================================================================

# Entorno de Ejecución
NODE_ENV=development

# Configuración de Base de Datos PostgreSQL / PostGIS
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=agrochain
DB_HOST=db
DB_PORT=5432

# Configuración del Backend REST API
PORT=3000
BACKEND_PORT=3000

# Clave Secreta para Firma y Verificación de Tokens JWT (RBAC)
JWT_SECRET=agrochain-super-secret-production-key-2026

# Configuración del Frontend
FRONTEND_PORT=5173
VITE_API_BASE=/api/v1
